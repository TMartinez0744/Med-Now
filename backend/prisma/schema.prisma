generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model profiles {
  id                     String                   @id @db.Uuid
  nombre_apellido        String
  dni                    String                   @unique
  tipo_usuario           String?
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  password               String?
  medicos                medicos?
  pacientes              pacientes?
  ficha_medica_historial ficha_medica_historial[]
}

model medicos {
  id                    String                 @id @db.Uuid
  especialidades        String[]
  sedes                 String[]
  email                 String?
  recibir_turnos        Boolean?               @default(true)
  perfil_completo       Boolean                @default(false)
  profiles              profiles               @relation(fields: [id], references: [id], onDelete: Cascade)
  turnos                turnos[]
  chat_rooms            chat_rooms[]
  medico_obras_sociales medico_obras_sociales?
}

model pacientes {
  id                     String                   @id @db.Uuid
  obra_social            String?
  ficha_medica           Json?
  perfil_completo        Boolean                  @default(false)
  profiles               profiles                 @relation(fields: [id], references: [id], onDelete: Cascade)
  turnos                 turnos[]
  chat_rooms             chat_rooms[]
  paciente_perfil        paciente_perfil?
  ficha_medica_historial ficha_medica_historial[]
}

model turnos {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paciente_id          String    @db.Uuid
  medico_id            String    @db.Uuid
  fecha_hora           DateTime  @db.Timestamptz(6)
  motivo_consulta      String?
  estado               String?   @default("pendiente")
  recordatorio_enviado Boolean?  @default(false)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  pacientes            pacientes @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  medicos              medicos   @relation(fields: [medico_id], references: [id], onDelete: Cascade)
}

model centros_emergencia {
  id          Int      @id @default(autoincrement())
  nombre      String
  tipo        String?
  direccion   String?
  latitud     Float?
  longitud    Float?
  abierto_24h Boolean? @default(true)
}

model disponibilidad {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medico_id      String?  @db.Uuid
  dia_semana     Int
  hora_inicio    DateTime @db.Time(6)
  hora_fin       DateTime @db.Time(6)
  sede           String?
  duracion_turno Int?     @default(30)

  @@unique([medico_id, dia_semana, hora_inicio])
}

model chat_rooms {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paciente_id    String   @db.Uuid
  medico_id      String   @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  tipo           String?  @default("turno")
  derivacion_id  String?  @db.Uuid
  pacientes      pacientes @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  medicos        medicos   @relation(fields: [medico_id], references: [id], onDelete: Cascade)
  mensajes       mensajes[]
  derivacion     derivaciones_pendientes? @relation(fields: [derivacion_id], references: [id], onDelete: SetNull)
}

model mensajes {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id    String     @db.Uuid
  sender_id  String     @db.Uuid
  contenido  String
  leido      Boolean    @default(false)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  tipo       String?    @default("texto")
  chat_rooms chat_rooms @relation(fields: [room_id], references: [id], onDelete: Cascade)
}

model derivaciones_pendientes {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paciente_id  String       @db.Uuid
  contexto     Json
  resumen      String?
  estado       String       @default("pendiente")
  medico_id    String?      @db.Uuid
  room_id      String?      @db.Uuid
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)
  aceptada_at  DateTime?    @db.Timestamptz(6)
  cancelada_at DateTime?    @db.Timestamptz(6)
  chat_rooms   chat_rooms[]
}

model paciente_perfil {
  paciente_id      String    @id @db.Uuid
  genero           String?
  fecha_nacimiento String?
  email            String?
  numero_afiliado  String?
  pacientes        pacientes @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
}

model medico_obras_sociales {
  medico_id      String   @id @db.Uuid
  obras_sociales String[]
  medicos        medicos  @relation(fields: [medico_id], references: [id], onDelete: Cascade)
}

model ficha_medica_historial {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paciente_id    String    @db.Uuid
  modificado_por String    @db.Uuid
  ficha_anterior Json?
  ficha_nueva    Json
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  pacientes      pacientes @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  profiles       profiles  @relation(fields: [modificado_por], references: [id], onDelete: Cascade)
}
