# ─── Servidor ────────────────────────────────────────────────
PORT=3000

# ─── Autenticación ───────────────────────────────────────────
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# ─── Supabase (proyecto principal) ───────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ─── Supabase (proyecto de sedes/perfiles) ───────────────────
# Si no se definen, se usan los del proyecto principal.
SUPABASE_SEDES_URL=
SUPABASE_SEDES_KEY=

# ─── Prisma (conexión directa a PostgreSQL) ──────────────────
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# ─── IA ──────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Email (recordatorios de turno) ──────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Producción ──────────────────────────────────────────────
# URL(s) del frontend deployado, para habilitar CORS.
# Separar por coma si hay más de una. Ej: https://mednow.vercel.app
FRONTEND_URL=
